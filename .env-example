# --- Foundry VTT account (required) ---
# Used to download Foundry and fetch your license on first start.
FOUNDRY_USERNAME='<YOUR_FOUNDRY_USERNAME>'
FOUNDRY_PASSWORD='<YOUR_FOUNDRY_PASSWORD>'

# --- Public access (required) ---
# Domain the Cloudflare tunnel serves Foundry on, e.g. foundry.example.com
FOUNDRY_HOSTNAME='<YOUR_DOMAIN>'

# --- Cloudflare tunnel (required) ---
CF_TUNNEL_TOKEN='<YOUR_CF_TUNNEL_TOKEN>'

# --- Optional ---
# Password for the Foundry setup/admin screen (recommended).
# Only applied on first start; afterwards change it in Foundry's Application Configuration.
FOUNDRY_ADMIN_KEY='<YOUR_ADMIN_PASSWORD>'
# Share anonymous usage data with Foundry: true or false (unset = ask once in the UI)
FOUNDRY_TELEMETRY=false
# Host directory for Foundry data (defaults to ./foundryData)
DATA_DIR='<YOUR_ABSOLUTE_PATH_TO_DATA_DIR>'
# Host port Foundry is published on (defaults to 30000)
FOUNDRY_PORT=30000
# TZ database name, e.g. Europe/London (defaults to UTC)
TIMEZONE='UTC'
